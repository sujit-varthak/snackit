# Copy this file to .env (git ignores it) and fill it in. Steps: docs/connect.md
# Never commit real values, and do not paste them into chat or tickets.
ZOHO_MODE=live
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# Only if Inventory shows a different organisation id from Books
ZOHO_INVENTORY_ORG_ID=
# Only if the head-office location is not called "Head Office"
ZOHO_HEAD_OFFICE_LOCATION_ID=
# Exporting transfer orders (docs/connect.md, "Exporting transfer orders to Zoho")
# Id of the "Vending Machine" custom field on Zoho transfer orders. Required to export.
ZOHO_MACHINE_FIELD_ID=
# Only if the location every machine belongs to is not called "Vending Machine"
ZOHO_VENDING_LOCATION_ID=
